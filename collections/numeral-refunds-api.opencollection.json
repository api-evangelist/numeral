{
  "opencollection": "1.0.0",
  "info": {
    "name": "Numeral Customers Refunds API",
    "version": "2026-03-01"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
