{
  "opencollection": "1.0.0",
  "info": {
    "name": "Numeral Customers API",
    "version": "2026-03-01"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
